# Cuentas de prueba para los tests e2e (Detox). Copiá este archivo como `.env`.
# Son usuarios que ya existen en el proyecto de Firebase configurado.
E2E_ATTENDEE_EMAIL=attendee@example.com
E2E_ATTENDEE_PASSWORD=change-me
# Cuenta con roles de organizador y de vendedor.
E2E_ORGANIZER_EMAIL=organizer@example.com
E2E_ORGANIZER_PASSWORD=change-me

# Clave de Google Maps para el build de Android. También puede pasarse como
# propiedad de Gradle (-PMAPS_API_KEY=...).
# MAPS_API_KEY=
